{
  "name": "zendesk-mcp-server",
  "version": "0.1.0",
  "type": "module",
  "description": "Read-only multi-instance MCP server for auditing Zendesk admin/configuration.",
  "main": "src/index.js",
  "bin": {
    "zendesk-mcp": "src/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "inspect": "npx -y @modelcontextprotocol/inspector node src/index.js",
    "test": "node --test",
    "postinstall": "node -e \"if(process.platform!=='win32'){try{require('fs').chmodSync('src/index.js',0o755)}catch{}}\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4"
  }
}
